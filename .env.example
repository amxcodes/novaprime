# Docker PostgreSQL bootstrap credentials. Use unique, URL-safe values: letters,
# digits, hyphen, underscore, period, or tilde. Keep the two passwords distinct.
# Docker-only users can generate these automatically with
# docker/bootstrap.ps1 (Windows) or docker/bootstrap.sh (Ubuntu).
NOVA_MIGRATOR_PASSWORD=replace-with-a-long-local-password
NOVA_APP_PASSWORD=replace-with-a-different-random-password-at-least-24-chars
NOVA_POSTGRES_PORT=5432
NOVA_API_PORT=3001
# Keep the API loopback-bound for local installs. Only set this when you have
# deliberately designed and secured a non-loopback network boundary.
# NOVA_API_BIND_ADDRESS=127.0.0.1
# Set true only when a trusted reverse proxy/edge strips incoming forwarded
# headers and rewrites x-forwarded-host/x-forwarded-proto and client-IP
# headers. This also enables per-client Better Auth rate-limit buckets.
# NOVA_TRUST_PROXY_HEADERS=false

# The migration account owns schema changes. It must never be used by normal API requests.
MIGRATOR_DATABASE_URL=postgresql://nova_migrator:replace-with-a-long-local-password@localhost:5432/nova

# The NOVA API uses this non-owner, non-BYPASSRLS role for normal requests.
DATABASE_URL=postgresql://nova_app:replace-with-a-different-long-local-password@localhost:5432/nova
NOVA_APPLICATION_DATABASE_ROLE=nova_app
# Per-process bounded pools; budget API replicas (DB + auth) and maintenance
# replicas (DB) together before increasing these for the database/provider.
NOVA_DB_POOL_MAX=10
NOVA_AUTH_POOL_MAX=5

# Local API + Supabase Cloud, or Netlify/Vercel + Supabase Cloud: replace
# DATABASE_URL above with the exact Transaction pooler URL from the project's
# Connect panel. A custom role uses
# nova_app.<project-ref> as the username; URL-encode its password. Current pg
# releases need this compatibility flag for Supabase's encrypted `require` mode:
# postgresql://nova_app.<project-ref>:<url-encoded-password>@<pooler-host>:6543/postgres?sslmode=require&uselibpqcompat=true
# Setup reads the project's exact transaction-pooler host from the Supabase
# Management API. If that read-only permission is unavailable, copy the host
# from the project's Connect panel; never guess the aws-N cluster index.
# NOVA_SUPABASE_POOLER_HOST=aws-3-region.pooler.supabase.com

# Embedded Better Auth. These values are used by the NOVA API, never the client.
# Generate BETTER_AUTH_SECRET and NOVA_BOOTSTRAP_TOKEN with high entropy.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Keep localhost for the root dev:local runner; use the deployed same-origin
# URL only in the corresponding Netlify, Vercel, or VPS environment.
BETTER_AUTH_URL=http://localhost:3001
NOVA_BOOTSTRAP_TOKEN=replace-with-a-separate-random-bootstrap-token

# Encrypts provider credentials saved through NOVA Email Delivery Settings.
# Generate 32 random bytes and base64url-encode them. Store this only in the
# Netlify/Vercel/VPS secret environment; never expose it to the browser.
NOVA_SECRETS_ENCRYPTION_KEY=replace-with-a-32-byte-base64url-secret
# Secret used only by the deployment scheduler to invoke the canonical
# background tick endpoint. Keep it out of browser/build-time variables.
NOVA_BACKGROUND_JOB_SECRET=replace-with-a-random-background-job-secret
# Non-secret selector shared by every runtime connected to this database.
# Use exactly one: cloudflare, netlify, vercel, supabase, or vps. Other built-in
# adapters will refuse to run the tick when their value does not match.
NOVA_BACKGROUND_SCHEDULER=vps
# Vercel only: set this to a separate random value. Vercel sends it as the
# Authorization header for its Cron request; the adapter translates that GET
# into the canonical POST using NOVA_BACKGROUND_JOB_SECRET.
# CRON_SECRET=replace-with-a-random-vercel-cron-secret
# Direct VPS Docker uses the same protected endpoint as hosted schedulers.
# NOVA_MAINTENANCE_ENDPOINT=http://api:3001/api/internal/background/tick

# One-time Supabase Cloud bootstrap only. `bun run setup:supabase` resolves the
# pooler host, applies migrations, and runs preflight. Do not add this token to
# Netlify, Vercel, or any deployed NOVA API environment.
NOVA_SUPABASE_PROJECT_REF=your-supabase-project-ref
SUPABASE_ACCESS_TOKEN=your-project-scoped-management-token

# Optional disposable authenticated smoke credentials. Set these only for
# scripts/runtime-specialized-smoke.ts after creating a test Super Admin; do
# not reuse a customer password and do not commit the values.
# NOVA_SMOKE_EMAIL=disposable-super-admin@example.test
# NOVA_SMOKE_PASSWORD=replace-with-a-disposable-password
# For direct PostgreSQL/VPS smoke, use the non-owner API URL plus a separate
# migration-owner fixture URL. Never point the API URL at the owner.
# NOVA_SMOKE_DATABASE_URL=postgresql://nova_app:...@localhost:5432/nova
# NOVA_SMOKE_FIXTURE_DATABASE_URL=postgresql://nova_migrator:...@localhost:5432/nova

# Deployment preflight expects this latest canonical migration by default.
# Comma-separated exact origins that are already mapped to this deployment and
# have HTTPS/DNS configured. Super Admin may select only one of these in NOVA.
# BETTER_AUTH_URL is always included as the fallback origin.
# NOVA_ALLOWED_ORIGINS=https://nova.example.com,https://www.nova.example.com
# NOVA_EXPECTED_MIGRATION=0066_task_due_date_edits.sql
